# Copia este archivo, renombralo a ".env" y completa los valores reales.
# Nunca subas el archivo ".env" (con los valores reales) a GitHub — solo este ".env.example".

# ---- Datos de tu proyecto de Supabase ----
# Los sacas de: Supabase → tu proyecto → Project Settings → API
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_KEY=pegar_aca_la_service_role_key

# ---- Seguridad ----
# Podes dejar este texto o cambiarlo por cualquier frase larga y unica
JWT_SECRET=prun_bienes_raices_clave_secreta_cambiar_en_produccion

# ---- Cuenta de administrador inicial ----
# Se crea sola la primera vez que arranca el servidor, si no existe todavia
ADMIN_EMAIL=admin@prunbienes.com
ADMIN_PASSWORD=admin1234

# ---- Puerto (Render lo define solo, no hace falta tocarlo) ----
PORT=3000
